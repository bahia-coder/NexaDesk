# Copy to .env and replace every placeholder. Never commit .env.

# --- Database ---
POSTGRES_DB=nexadesk
POSTGRES_USER=nexadesk
POSTGRES_PASSWORD=change-me-strong-password

# --- Application ---
# prod, or prod,demo to load the demonstration dataset (never use demo for real data)
SPRING_PROFILES_ACTIVE=prod
APP_TIMEZONE=Europe/Paris
WEB_PORT=8088

# --- Security ---
# Base64 HMAC key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# Browser origin(s) allowed to call /api/auth/refresh and /logout (comma-separated)
APP_ALLOWED_ORIGINS=http://localhost:8088
# Must stay true behind HTTPS. Browsers accept Secure cookies on http://localhost.
AUTH_COOKIE_SECURE=true

# --- AI ---
# disabled | heuristic (default, free, no model) | llm
# llm falls back to heuristic when its settings are incomplete (warning in the logs).
AI_MODE=heuristic
# anthropic (Claude, official SDK) | openai-compatible (Ollama, OpenAI, Mistral, Groq...)
AI_PROVIDER=anthropic
# Anthropic: required. openai-compatible: optional (a local Ollama needs none).
AI_API_KEY=
# openai-compatible only. Ollama from the API container: http://host.docker.internal:11434/v1
AI_BASE_URL=
# Empty = claude-opus-5-5 for anthropic; required for openai-compatible (e.g. llama3.2)
AI_MODEL=
