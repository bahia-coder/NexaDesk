# Copy to .env and replace every placeholder. Never commit .env.

# --- Database ---
POSTGRES_DB=nexadesk
POSTGRES_USER=nexadesk
POSTGRES_PASSWORD=change-me-strong-password

# --- Application ---
# prod | demo (demo loads the demonstration dataset — never use demo for real data)
SPRING_PROFILES_ACTIVE=prod
APP_TIMEZONE=Europe/Paris
WEB_PORT=8088

# --- Security (used from Phase 3) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- AI (used from Phase 3) ---
# disabled | heuristic | llm   (llm falls back to heuristic when AI_API_KEY is empty)
AI_MODE=heuristic
AI_API_KEY=
